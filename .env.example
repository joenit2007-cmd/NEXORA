# NEXORA Environment Configuration
# Copy this file to .env and update values before running in production.

FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-hex-secret-in-production
DATABASE_URL=sqlite:///nexora.db

# Upload and security limits
MAX_CONTENT_LENGTH=5242880
SESSION_COOKIE_SECURE=false
WTF_CSRF_ENABLED=true

# Detection defaults
LOG_BRUTE_FORCE_THRESHOLD=5
LOG_BRUTE_FORCE_WINDOW_MINUTES=10

# Optional explicit path to Nmap binary (auto-detected if omitted)
NMAP_PATH=

# Optional initial admin bootstrap (used only by CLI seed-admin command)
NEXORA_ADMIN_USERNAME=admin
NEXORA_ADMIN_EMAIL=admin@nexora.local
NEXORA_ADMIN_PASSWORD=
